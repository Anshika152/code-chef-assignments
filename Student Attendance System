#include <stdio.h>
int main() {
    int n;
    scanf("%d", &n);

    int arr[100];
    int present = 0, absent = 0;

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        if (arr[i] == 1)
            present++;
        else
            absent++;
    }

    printf("Present: %d\n", present);
    printf("Absent: %d\n", absent);

    return 0;
}
